# Copie para .env.local e ajuste.

# API do Nexus. Local: a stack do docker compose. AWS: a saida api_endpoint do Terraform.
VITE_API_URL=http://localhost:8080

# "none" no ambiente local (a API local nao exige token).
# "cognito" quando apontar para a AWS.
VITE_AUTH_MODE=none

# Usados apenas com VITE_AUTH_MODE=cognito. Vem das saidas do Terraform.
# O client id e publico por natureza: vai para o JavaScript e nao e segredo.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=us-east-1

# Intervalo de atualizacao, em milissegundos.
VITE_POLL_INTERVAL_MS=3000
