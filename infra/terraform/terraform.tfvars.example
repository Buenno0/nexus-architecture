# Copie para terraform.tfvars e ajuste. terraform.tfvars NAO deve ser versionado.

aws_region  = "us-east-1"
environment = "dev"

# Obrigatorio: recebe os alertas de orcamento.
budget_notification_email = "voce@exemplo.com"

# Origem do Control Center. Nunca "*".
cors_allowed_origin = "https://nexus.mateus-bueno.dev"

# PROVISIONED com 25 WCU/RCU fica na franquia gratuita (custo zero), mas estrangula
# acima de 25 escritas/segundo. Troque para PAY_PER_REQUEST antes de testes de carga.
dynamodb_billing_mode = "PAY_PER_REQUEST"

# Desligue para uma demonstracao estritamente sob demanda.
enable_safety_net = true

# ------------------------------------------------------------------ demonstracao

# Liga a demonstracao publica: a ingestao livre sai do roteamento e a unica entrada
# passa a ser POST /v1/demo/seed, que gera no servidor.
demo_mode = true

# Tetos avaliados NO SERVIDOR. A interface nao limita nada: a credencial do convidado
# viaja no bundle JavaScript. Ver SECURITY.md.
demo_max_per_call = 200
demo_max_total    = 5000

# Senha do convidado. Minimo 12 caracteres, com maiuscula, minuscula, numero e simbolo.
#
# Esta credencial e PUBLICA por construcao: ela vai para o JavaScript do painel para
# que o visitante nao veja tela de login. Nao reuse nenhuma senha sua. O que protege a
# plataforma nao e ela — sao os tetos do servidor, o throttle e o fato de o convidado
# nao receber nenhuma credencial da AWS.
demo_guest_password = "troque-esta-senha"
