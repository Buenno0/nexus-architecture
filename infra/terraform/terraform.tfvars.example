# Copie para terraform.tfvars e ajuste. terraform.tfvars NAO deve ser versionado.

aws_region  = "us-east-1"
environment = "dev"

# Obrigatorio: recebe os alertas de orcamento.
budget_notification_email = "voce@exemplo.com"

# Origem do Control Center. Nunca "*".
cors_allowed_origin = "https://nexus.mateus-bueno.dev"

# PROVISIONED com 25 WCU/RCU fica na franquia gratuita (custo zero), mas estrangula
# acima de 25 escritas/segundo. Troque para PAY_PER_REQUEST antes de testes de carga.
dynamodb_billing_mode = "PAY_PER_REQUEST"

# Desligue para uma demonstracao estritamente sob demanda.
enable_safety_net = true
