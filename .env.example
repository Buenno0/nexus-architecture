# Nexus Architecture — variaveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env.

NEXUS_ENV=local
NEXUS_LOG_LEVEL=INFO
NEXUS_SERVICE_NAME=nexus-ingestion

# DynamoDB
NEXUS_DYNAMO_ENDPOINT=http://localhost:8000
NEXUS_DYNAMO_TABLE=nexus-records
NEXUS_AWS_REGION=us-east-1

# Credenciais FALSAS exigidas pelo DynamoDB Local (nao sao segredos reais)
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Fila local (ADR-004). Use 'none' para desligar e ver o outbox acumular.
NEXUS_QUEUE_BACKEND=sqlite
# Caminho da fila. Dentro do container e /data/nexus-queue.db (volume nomeado).
# NAO compartilhe este arquivo entre host e container: ver ADR-004.
NEXUS_QUEUE_PATH=./data/nexus-queue.db
NEXUS_QUEUE_VISIBILITY_TIMEOUT_SECONDS=30
NEXUS_QUEUE_MAX_RECEIVE=3

# Worker
NEXUS_WORKER_BATCH_SIZE=10

# Injecao de falhas: fracao de processamentos que falham de proposito.
# Exercita retentativa e DLQ sem adulterar os dados de entrada.
NEXUS_FAILURE_INJECTION_RATE=0.0

# Limites de seguranca
NEXUS_MAX_BATCH_RECORDS=10000
